# syntax=docker/dockerfile:1

# =========================
# Stage 1: Builder (release 모드)
# =========================
FROM rust:1.89 as builder

# 빌드 의존성 설치
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libmariadb-dev \
    findutils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 소스 코드 복사
COPY . .

# 릴리스 모드 빌드
ENV SQLX_OFFLINE=1
RUN cargo build --release

# 빌드 산출물 복사
RUN install -Dm755 target/release/OmniNews /dist/omninews_back

# =========================
# Stage 2: Runtime - 빌더와 동일한 환경 사용
# =========================
FROM rust:1.89-slim

# 기본 런타임 의존성 (최소화)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl-dev \
    default-libmysqlclient-dev \
 && rm -rf /var/lib/apt/lists/*

# 비루트 유저
RUN useradd -m -u 1000 omninews
WORKDIR /app

# 빌드 산출물 복사
COPY --from=builder /dist/omninews_back /app/omninews_back
COPY --from=builder /app/Rocket.toml /app/Rocket.toml

# 디렉터리/권한
RUN mkdir -p /app/logs /app/static /app/templates \
 && chown -R omninews:omninews /app

USER omninews
EXPOSE 1027
CMD ["/app/omninews_back"]
